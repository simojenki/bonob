<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= it.title || "bonob" %></title>
    <style>
body {
  font-family: -apple-system,BlinkMacSystemFont,"Segoe UI","Roboto","Oxygen","Ubuntu","Cantarell","Fira Sans","Droid Sans","Helvetica Neue",sans-serif;
}    

div#content {
  margin: auto;
  width: 60%;
}

h1 {
  font-size: 700%;
  overflow-wrap: break-word;
}

label {
  font-size: 300%;
}

input {
  font-size: 300%;
  width: 80%;
}

input#submit {
  margin-top: 100px
}

.one-word-per-line {
  word-spacing: normal;
}

.login {
  width: auto;
  display: block;
}

@media (max-width: 600px) {
  div#content {
    width: 90%;
  }

  h1 {
    font-size: 300%;
  }

  h1.cause {
    font-size: 175%;
  }

  label, input {
    font-size: 150%;
  }

  input {
    width: 100%;
    box-sizing: border-box;
  }

  input#submit {
    margin-top: 40px;
  }
}
    </style>
  </head>
  <body>
    <%~ it.body %>
  </body>
</html>